{%- comment -%}
  PhiXtra chat (Shopify app, Part 3, 2 Nov 2026): the PhiXtra chat box on
  every page of the store. The business's chat key is app data set by
  PhiXtra when the store is linked. For a logged-in customer, their name,
  email and B2B company go to the chat, signed with the store's own secret
  (also app data, never shown on the page) so they can't be faked.
{%- endcomment -%}
{%- assign phx_key = app.metafields.phixtra.site_key.value -%}
{%- if phx_key != blank -%}
  {%- assign phx_secret = app.metafields.phixtra.visitor_secret.value -%}
  {%- assign phx_attrs = '' -%}
  {%- if customer and phx_secret != blank -%}
    {%- assign phx_name = customer.name | strip -%}
    {%- assign phx_email = customer.email | strip -%}
    {%- assign phx_company = '' -%}
    {%- if customer.current_company -%}{%- assign phx_company = customer.current_company.name | strip -%}{%- endif -%}
    {%- capture phx_payload -%}{{ phx_name }}|{{ phx_email }}|{{ phx_company }}{%- endcapture -%}
    {%- assign phx_sig = phx_payload | hmac_sha256: phx_secret -%}
    {%- capture phx_attrs %} data-visitor-name="{{ phx_name | escape }}" data-visitor-email="{{ phx_email | escape }}" data-visitor-company="{{ phx_company | escape }}" data-visitor-sig="{{ phx_sig }}"{% endcapture -%}
  {%- endif -%}
  <script src="https://chat.phixtra.com/widget.js?v=20261102b" data-site="{{ phx_key | escape }}" data-platform="shopify"{{ phx_attrs }} defer></script>
{%- endif -%}

{% schema %}
{
  "name": "PhiXtra chat",
  "target": "body",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the PhiXtra chat on every page of your store."
    }
  ]
}
{% endschema %}
